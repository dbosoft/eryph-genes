{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@dbosoft/build-geneset#build": {
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "publish": {
      "dependsOn": ["^publish"],
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
