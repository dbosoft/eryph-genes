{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["dist/**", "../../genes/**", "!**/.packed/*"]
    },
    "publish": {
      "dependsOn": ["^publish"],
      "cache": false,
      "outputs": ["dist/**", "../../genes/**", "!**/.packed/*"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}